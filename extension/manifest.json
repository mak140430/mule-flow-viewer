{
  "manifest_version": 3,
  "name": "Mule Flow Viewer",
  "version": "0.1.4",
  "description": "Mule 4 flows as Studio draws them, from Azure DevOps, GitHub, GitLab or Bitbucket: branches, history, pull requests, checks.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open in Mule Flow Viewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*",
    "https://api.github.com/*",
    "https://gitlab.com/*",
    "https://bitbucket.org/*",
    "http://127.0.0.1/*"
  ],
  "options_page": "setup.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open the page in Mule Flow Viewer"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://dev.azure.com https://*.visualstudio.com https://api.github.com https://gitlab.com https://bitbucket.org https://fonts.googleapis.com https://fonts.gstatic.com http://127.0.0.1:* http://localhost:*"
  }
}
